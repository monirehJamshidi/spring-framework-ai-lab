POST http://localhost:8081/api/ai/chat
Content-Type: application/json

{
  "conversationId": "calculator-test-003",
  "message": "Calculate simple interest for principal 1000 euros, annual rate 3 percent, and duration 6 months. Use the calculator tool."
}

